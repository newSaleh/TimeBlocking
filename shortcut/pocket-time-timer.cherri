/*
Pocket Time Timer: starts the Clock app's own timer, which rings even when
the iPhone is locked. The day page opens it with
shortcuts://run-shortcut?name=Pocket%20Time%20Timer&input=text&text=<minutes>
Run by hand, it asks for the minutes. Nothing is sent anywhere.
*/

#define name Pocket Time Timer
#define color blue
#define glyph clock

@minutes = "{ShortcutInput}"
if !minutes {
    @minutes = prompt("كم دقيقة؟", "Number", "30")
}

rawAction("is.workflow.actions.timer.start", {
    "WFDuration": {
        "Value": {
            "Magnitude": {
                "Value": { "Type": "Variable", "VariableName": "minutes" },
                "WFSerializationType": "WFTextTokenAttachment"
            },
            "Unit": "min"
        },
        "WFSerializationType": "WFQuantityFieldValue"
    }
})
